{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information" //Logs every forwarded request
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/v1/orders/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      },
      "dev-token-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/v1/dev/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/v1/inventory/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5214/" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5213/" }
        }
      }
    }
  }
}

//No Payments route	Payments has no public endpoints