{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information" //Logs every forwarded request
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "orderflow-dev",
    "Audience": "orderflow-api"
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "orders-read": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/v1/orders/{**rest}",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "per-client",
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      },
      "orders-write": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/v1/orders/{**rest}",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "PlaceOrders",
        "RateLimiterPolicy": "per-client",
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      },
      "dev-token-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/v1/dev/{**rest}",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "per-client",
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      },
      "inventory-read": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/v1/inventory/{**rest}",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "per-client",
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      },
      "inventory-write": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/v1/inventory/{**rest}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "ManageStock",
        "RateLimiterPolicy": "per-client",
        "Transforms": [
          { "PathRemovePrefix": "/v1" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5214/" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5213/" }
        }
      }
    }
  }
}

//No Payments route	Payments has no public endpoints