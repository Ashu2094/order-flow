@host = http://localhost:5214
# @host = http://localhost:8082
@orderId = PASTE-AN-ID-HERE

### 01 Ping -> 200
GET {{host}}/ping

### 02 Create order -> 201 (prices come from Inventory)
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "Asha Rao",
  "items": [
    {
      "sku": "kb-001",
      "quantity": 2
    },
    {
      "sku": "ms-002",
      "quantity": 1
    }
  ]
}

### 03 Get order -> 200 with 2 items
GET {{host}}/api/orders/05a505a7-0fae-4911-a266-9d6446a3b97d

### 04 Unknown order -> 404
GET {{host}}/api/orders/99999999-9999-9999-9999-999999999999

### 05 No items -> 400
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "Asha Rao",
  "items": []
}


### 06 Invalid item -> 400 with 2 errors
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "Asha Rao",
  "items": [
    {
      "sku": "",
      "quantity": 0
    }
  ]
}

### 07 List page 1
GET {{host}}/api/orders?page=1&pageSize=10

### 08 List page 2
GET {{host}}/api/orders?page=&pageSize=10

### 09 Default paging
GET {{host}}/api/orders

### 10 Bad page
GET {{host}}/api/orders?page=-1&pageSize=10

### 11 Huge page size
GET {{host}}/api/orders?page=1&pageSize=100000

### 12 Health -> 200 Healthy
GET {{host}}/health

### 13 Unknown SKU -> 400
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "Asha Rao",
  "items": [
    {
      "sku": "nope-1",
      "quantity": 1
    }
  ]
}

### 14 Order too much -> 201 now, Failed a moment later
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "Asha Rao",
  "items": [
    {
      "sku": "kb-001",
      "quantity": 1000
    }
  ]
}
  

