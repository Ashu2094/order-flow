@host = http://localhost:5213
@itemId = PASTE-AN-ID-HERE

### 01 Ping -> 200
GET {{host}}/ping

### 02 List -> 200
GET {{host}}/api/inventory

### 03 Create valid -> 201 with Location header
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "wc-009",
  "name": "Webcam",
  "description": "1080p",
  "quantity": 12,
  "price": 59.00
}

### 04 Create duplicate SKU -> 409
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "WC-009",
  "name": "Webcam again",
  "quantity": 1,
  "price": 1
}

### 05 Get one -> 200
GET {{host}}/api/inventory/{{itemId}}

### 06 Get unknown id -> 404
GET {{host}}/api/inventory/99999999-9999-9999-9999-999999999999

### 07 Update -> 200
PUT {{host}}/api/inventory/{{itemId}}
Content-Type: application/json

{
  "name": "Webcam",
  "description": "1080p",
  "quantity": 30,
  "price": 59.00
}

### 08 Update unknown id -> 404
PUT {{host}}/api/inventory/99999999-9999-9999-9999-999999999999
Content-Type: application/json

{
  "name": "Ghost",
  "quantity": 1,
  "price": 1
}

### 09 Empty name -> 400
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "OK-1",
  "name": "",
  "quantity": 5,
  "price": 10
}

### 10 Negative quantity -> 400
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "OK-1",
  "name": "Thing",
  "quantity": -3,
  "price": 10
}

### 11 Invalid SKU -> 400
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "bad sku!",
  "name": "Thing",
  "quantity": 5,
  "price": 10
}

### 12 Everything bad -> 400 with 4 errors
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "",
  "name": " ",
  "quantity": -1,
  "price": -5
}

### 13 Empty body -> 400
POST {{host}}/api/inventory
Content-Type: application/json

### 14 Text where a number belongs -> 400
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "OK-2",
  "name": "Thing",
  "quantity": "lots",
  "price": 10
}

### 15 Wrong verb -> 405
DELETE {{host}}/api/inventory

### 16 Unknown route -> 404
GET {{host}}/api/nothing

### 17 Delete -> 204
DELETE {{host}}/api/inventory/{{itemId}}

### 18 Get the deleted item -> 404
GET {{host}}/api/inventory/{{itemId}}

### 19 Health -> 200 Healthy
GET {{host}}/health


### 20 Seed keyboard -> 201 (or 409 if it exists)
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "KB-001",
  "name": "Keyboard",
  "quantity": 25,
  "price": 49.99
}

### 21 Seed mouse -> 201 (or 409 if it exists)
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "MS-002",
  "name": "Mouse",
  "quantity": 40,
  "price": 19.50
}

### 22 Get by SKU -> 200
GET {{host}}/api/inventory/by-sku/kb-001

### 23 Seed the last unit -> 201
POST {{host}}/api/inventory
Content-Type: application/json

{
  "sku": "LAST-001",
  "name": "Last Unit Widget",
  "quantity": 1,
  "price": 10.00
}
